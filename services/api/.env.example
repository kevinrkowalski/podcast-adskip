# Primary: OpenRouter (STT + chat). Leave empty for stub/mock mode.
OPENROUTER_API_KEY=
# Optional override (default https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Legacy Groq (optional — demoted; prefer OPENROUTER_API_KEY)
GROQ_API_KEY=

# LLM labeling provider: openrouter (default) | groq | gemini | stub
LLM_PROVIDER=openrouter
LLM_API_KEY=
GEMINI_API_KEY=

# Force stub pipeline even if keys are present
MOCK_ANALYZE=false

# Optional shared secret for personal use (X-App-Key header)
APP_KEY=
# When true, protected routes require APP_KEY (503 if APP_KEY empty). false = open local LAN.
REQUIRE_APP_KEY=false

# CORS — use * for local mobile/dev, or comma-separated origins
CORS_ORIGINS=*

# SQLite path for skip-map cache
DATABASE_PATH=data/skip_maps.db

# Models (OpenRouter slugs)
# STT: affordable Whisper-class with verbose_json segment timestamps
WHISPER_MODEL=openai/whisper-large-v3-turbo
# Chat: cheap OpenRouter model for ad labeling
OPENROUTER_LLM_MODEL=google/gemini-2.5-flash
# Legacy Groq / direct Gemini overrides
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-flash

# Per-chunk STT upload cap (OpenRouter multipart ≈25 MB; larger files are ffmpeg-chunked)
MAX_AUDIO_MB=25

# Optional OpenRouter attribution headers
OPENROUTER_HTTP_REFERER=https://github.com/podcast-adskip
OPENROUTER_APP_TITLE=podcast-adskip

# In-memory rate limit for POST /v1/analyze-episode (guards OpenRouter spend)
ANALYZE_RATE_LIMIT=10
ANALYZE_RATE_WINDOW_SECONDS=3600
